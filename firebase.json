{
    "hosting": {
        "public": "public",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "headers": [
            {
                "source": "/privacy-policy",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=300"
                    }
                ]
            },
            {
                "source": "/privacy-policy/**",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=300"
                    }
                ]
            }
        ],
        "cleanUrls": true,
        "trailingSlash": false
    },
    "functions": [
        {
            "source": "functions",
            "codebase": "default",
            "runtime": "nodejs20",
            "ignore": [
                "node_modules",
                ".git",
                "firebase-debug.log"
            ]
        }
    ]
}
